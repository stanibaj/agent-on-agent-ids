# ---- Opik connection -------------------------------------------------------
# Opik Cloud: keep the URL, set key + workspace. Self-hosted: http://localhost:5173/api and no key.
# Anything left empty falls back to ~/.opik.config (written by `opik configure`).
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_API_KEY=
OPIK_WORKSPACE=
# Project that receives your agent's traces (must already exist).
OPIK_PROJECT_NAME=

# ---- Judge -----------------------------------------------------------------
# Model id as Opik names it. Opik picks the AI provider (Configuration -> AI Providers) from this id:
#   OpenRouter: ~vendor/model-latest or vendor/model    Anthropic: claude-...    OpenAI: gpt-...
#   Gemini: gemini-...    Vertex AI: vertex_ai/...    your own endpoint (vLLM, Ollama, Bedrock, Azure via a proxy):
#   custom-llm/<provider name>/<model>, listed in that provider's Models field. See docs/models.md#bring-your-own-model
#   small fast chat models (agent-as-a-judge, any trace size, severity + mapping):
#     ~anthropic/claude-haiku-latest (default), ~google/gemini-flash-latest, ~openai/gpt-mini-latest, ~z-ai/glm-flash-latest
#   decision models (yes/no classifier, cheapest; 32k context, oversized traces are skipped by Opik):
#     typesafe/jev-1.13, ~typesafe/jev-latest
# Validate any other model with scripts/validate_judge.py -- some larger models refuse to analyse attack payloads.
AOA_JUDGE_MODEL=~anthropic/claude-haiku-latest
AOA_JUDGE_TEMPERATURE=0
# Chat models only (decision models always use mapped):
# agent  = agent-as-a-judge: the judge reads the trace and its spans with tools (recommended)
# mapped = single call with input / output / all spans injected as JSON
AOA_JUDGE_MODE=agent
# Fraction of production traces to score (1.0 = all). Cost cap per evaluation in USD (chat models; "none" = no cap).
AOA_SAMPLING_RATE=1.0
AOA_MAX_COST_USD=0.25
# Describe your agent so routine work is not flagged. Default: profiles/generic.md
# Example: profiles/hermes-sysadmin.md, or your own file under profiles/local/ (git-ignored).
AOA_AGENT_PROFILE_FILE=
# Mapped mode only: trace field paths for the operator input and final output.
AOA_VAR_INPUT=input
AOA_VAR_OUTPUT=output
AOA_RULE_NAME=aoa_ids_incident_detector

# ---- Alerting --------------------------------------------------------------
# Generic webhook (n8n, Alertmanager bridge, ntfy, SIEM...). Leave empty to skip alerts.
AOA_ALERT_WEBHOOK_URL=
AOA_ALERT_WEBHOOK_SECRET=
# Or Telegram instead of a webhook: a bot token from @BotFather and the chat to post to (your user id for a DM,
# -100... for a group). Opik calls the Bot API directly, so nothing else to host. Use a bot your agent can't control.
AOA_TELEGRAM_BOT_TOKEN=
AOA_TELEGRAM_CHAT_ID=
# Or Slack: an incoming-webhook URL. Opik posts a message linking each flagged trace.
AOA_SLACK_WEBHOOK_URL=
# Or PagerDuty: the integration key of an Events API v2 integration on your service.
AOA_PAGERDUTY_ROUTING_KEY=
# Set one destination only.
# An alert fires when at least one trace in this window is flagged.
AOA_ALERT_WINDOW_SECONDS=300
# actionable = attacks the agent acted on (severity >= 2)   any = every attempt, incl. ignored/blocked ones
# both = two alerts (e.g. page on actionable, send "any" to a security channel via a second install/webhook)
AOA_ALERT_ON=actionable

# ---- Coverage (aoa-ids coverage opik) -----------------------------------------
# Share of the agent's traces the judge actually scored. An unscored trace is a silent miss.
# Run `aoa-ids coverage opik --notify` from cron to hear about it on the destination above.
AOA_COVERAGE_HOURS=24
AOA_COVERAGE_MIN=0.95

# ---- Reference runners / validation (scripts/validate_judge.py, aoaids.runner) ----
AOA_RUNNER_BASE_URL=https://openrouter.ai/api/v1
AOA_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Defaults to OPENROUTER_API_KEY
AOA_RUNNER_API_KEY=
